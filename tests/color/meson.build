# Regression tests for sRGB / gAMA / iCCP coexistence and the PNG
# color-space chunk precedence rules (PNG 1.2 13.13, PNG Third Edition).
# The PNG files are generated by make_color_test_png.py; the ICC profile
# fixture (srgb-test-profile.icc) is a valid lcms sRGB monitor profile.
color_test_pngs = [
    # required: sRGB + gAMA + iCCP present together, conformant gAMA
    'color_srgb_gama_iccp.png',
    # required: sRGB + gAMA + iCCP present together, non-conformant gAMA
    'color_srgb_gama_bad_iccp.png',
    # sRGB + iCCP, no gAMA
    'color_srgb_iccp.png',
    # sRGB paired with a non-conformant gAMA, sRGB must take precedence
    'color_srgb_gama_bad.png',
    # gAMA + iCCP without sRGB, gAMA drives the correction
    'color_gama_iccp.png',
    # iCCP-only and no-profile fallback: gamma is a no-op
    'color_iccp_only.png',
    'color_none.png',
    # rendering intent distinction
    'color_srgb_intent0.png',
    'color_srgb_intent1.png',
    # plain gAMA fallback
    'color_gama_only.png',
    # 16-bit sources
    'color16_srgb_gama_iccp.png',
    'color16_srgb_gama_bad_iccp.png',
    'color16_srgb.png',
    'color16_iccp_only.png',
    'color16_none.png',
]

foreach png_file : color_test_pngs
    test('color_' + png_file.split('.')[0], test_exe, args : files(png_file))
endforeach

# Tolerance-free check of the effective gamma decision; links only libspng.
color_precedence_exe = executable('test_color_precedence',
    'test_color_precedence.c',
    dependencies : [ spng_dep, m_dep ]
)

test('color_precedence', color_precedence_exe,
    args : meson.current_source_dir())
